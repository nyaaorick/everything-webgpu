{
  "manifest_version": 2,
  "name": "Everything WebGPU",
  "version": "0.1.0",
  "description": "Local 4B+ LLM engine for Firefox on macOS. Zero-download: drag a compiled MLC model folder in, run it on WebGPU/Metal, and expose it to other extensions.",
  "browser_specific_settings": {
    "gecko": {
      "id": "everything-webgpu@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "page": "src/background/background.html",
    "persistent": true
  },
  "browser_action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Everything WebGPU"
  },
  "options_ui": {
    "page": "src/manager/manager.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
}
